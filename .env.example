# TurtleWorks — environment variables
# Set these in Vercel → Project → Settings → Environment Variables (Production),
# then redeploy. Pages are static, so changes only apply to a new build.
# Never commit real values; this file is a template.

# ── Enquiry delivery (set ONE option, or the contact form stays hidden) ───────

# Option A — webhook: enquiries are POSTed here as JSON (n8n, Make, Zapier…)
CONTACT_WEBHOOK_URL=
# Optional shared secret, sent as the x-contact-secret header
CONTACT_WEBHOOK_SECRET=

# Option B — email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain you've verified in Resend
CONTACT_FROM_EMAIL="TurtleWorks <site@turtleworks.in>"

# Set only while an AI service processes enquiries (n8n TW-05). Adds the
# disclosure to /privacy, e.g. "OpenAI API"
ENQUIRY_AI_PROCESSOR=

# ── Public details (shown on the site) ────────────────────────────────────────

# Public inbox shown as a direct-email option
NEXT_PUBLIC_CONTACT_EMAIL=
# Registered / trading entity (footer, privacy notice, structured data)
NEXT_PUBLIC_LEGAL_NAME=
# Where you operate from, e.g. "Hyderabad, India"
NEXT_PUBLIC_LOCATION=
# https booking page (Google Calendar appointment schedule, Cal.com, Calendly) — adds "Book a call"
NEXT_PUBLIC_BOOKING_URL=

# ── Optional ──────────────────────────────────────────────────────────────────

# Canonical origin (defaults to https://turtleworks.in)
NEXT_PUBLIC_SITE_URL=
# 1 = load Vercel Web Analytics (enable it in the Vercel dashboard first)
NEXT_PUBLIC_ENABLE_ANALYTICS=
