    {
      "id": "db4416d1-6171-4135-a261-fe5e53dc045c",
      "name": "Prepare lead record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// Normalises the website payload into one lead record.\n// topic_hint is a keyword guess against the six TurtleWorks service lines — a triage aid, not a classification.\nconst TOPICS = [\n  [\"Consulting\", /\\b(consult|strateg|roadmap|advice|advis|assess|audit|discovery)/],\n  [\"Custom software\", /\\b(app|application|software|website|web site|portal|platform|develop|mvp|dashboard|internal tool)/],\n  [\"Automation\", /\\b(automat|integrat|workflow|n8n|zapier|api|sync|pipeline|crm|erp|manual|spreadsheet|excel)/],\n  [\"Digital experience\", /\\b(ux|ui|design|redesign|user experience|interface|accessib)/],\n  [\"Search & growth\", /\\b(seo|search engine|google|marketing|traffic|ranking|ads|campaign)/],\n  [\"Cloud & cost\", /\\b(cloud|azure|aws|gcp|hosting|server|cost|billing|finops|infrastructure|devops)/],\n];\nconst clean = (v, max) => String(v ?? \"\").replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g, \"\").trim().slice(0, max);\nconst ist = (d) => new Date(d).toLocaleString(\"en-IN\", { timeZone: \"Asia/Kolkata\", dateStyle: \"medium\", timeStyle: \"short\" });\n\nreturn $input.all().map(({ json }) => {\n  const b = json.body ?? {};\n  const now = new Date();\n  const name = clean(b.name, 120);\n  const company = clean(b.company, 160);\n  const message = clean(b.message, 5000);\n  const text = `${message} ${company}`.toLowerCase();\n  const topics = TOPICS.filter(([, re]) => re.test(text)).map(([t]) => t);\n  const firstName = (name.split(/\\s+/)[0] || \"\").replace(/[^\\p{L}'-]/gu, \"\").slice(0, 40);\n\n  return {\n    json: {\n      lead_id: `TW-${now.toISOString().slice(0, 10).replace(/-/g, \"\")}-${Math.random().toString(36).slice(2, 6).toUpperCase()}`,\n      received_at: now.toISOString(),\n      received_at_ist: ist(now),\n      name,\n      first_name: firstName || \"there\",\n      email: clean(b.email, 254).toLowerCase(),\n      company,\n      preferred_time: clean(b.preferredTime, 120),\n      message,\n      topic_hint: topics.length ? topics.join(\", \") : \"Unclassified\",\n      source_page: clean(b.page, 300) || \"/\",\n      status: \"new\",\n    },\n  };\n});"
      }
    },
    {
      "id": "bc6246ef-7dd5-4422-a4bd-3086d4d295e4",
      "name": "Notify team — new enquiry",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "sendTo": "__TEAM_INBOX__",
        "subject": "=[{{ $json.lead_id }}] New enquiry — {{ $json.name }}{{ $json.company ? ' (' + $json.company + ')' : '' }} · {{ $json.topic_hint }}",
        "emailType": "text",
        "message": "=New enquiry from the TurtleWorks website\n\nReference:   {{ $json.lead_id }}\nReceived:    {{ $json.received_at_ist }} IST\nName:        {{ $json.name }}\nEmail:       {{ $json.email }}\nCompany:     {{ $json.company || '—' }}\nBest time:   {{ $json.preferred_time || '—' }}\nTopic hint:  {{ $json.topic_hint }} (automatic keyword guess)\nPage:        {{ $json.source_page }}\n\n— Message —\n{{ $json.message }}\n\n—\nReply to this email to answer {{ $json.first_name }} directly.\nWhen you've replied, set status to \"replied\" in n8n → Data tables → \"TW Leads — website enquiries\" so the daily reminder stops.",
        "options": {
          "appendAttribution": false,
          "senderName": "TurtleWorks Website",
          "replyTo": "={{ $json.email }}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "__GMAIL_CREDENTIAL_ID__",
          "name": "Gmail account 2"
        }
      }
    },
    {
      "id": "aa67110f-fe30-4dcd-a6e9-f4de11ea7c3f",
      "name": "Confirm receipt to website",
