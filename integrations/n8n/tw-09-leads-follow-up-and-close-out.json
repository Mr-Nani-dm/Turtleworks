    {
      "id": "f029848f-35f2-4a64-a30c-876345469097",
      "name": "Update CRM row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1820,
        60
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "__CRM_SHEET_ID__"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Lead ID": "={{ $json.final_row[\"Lead ID\"] }}",
            "Created Date": "={{ $json.final_row[\"Created Date\"] }}",
            "Name": "={{ $json.final_row[\"Name\"] }}",
            "Phone": "={{ $json.final_row[\"Phone\"] }}",
