        "mode": "runOnceForEachItem",
        "jsCode": "const d = $('Reply needed?').item.json;\nconst err = $json.error || {};\nconst why = String(err.description || err.message || JSON.stringify(err) || \"unknown\").slice(0, 150);\nconst updates = d.updates_failed.map((u, i) => (i === 0 ? { ...u, \"Send Error\": \"Send Failed: \" + why } : u));\nreturn { json: { ...d, final_updates: updates, send_result: \"failed\", send_error: why } };"
      }
    },
